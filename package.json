{
  "name": "dsh-enhanced-model-support",
  "version": "2.0.0",
  "description": "DSH – Enhanced Model Support: one model seat for DeepSeek Harness that combines model selection, thinking-strength control, subscription usage and the subscription providers (ChatGPT/Codex, Claude, Grok, GitHub Copilot, Google Antigravity) themselves.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.4.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-seat",
    "thinking",
    "subscription",
    "usage",
    "oauth",
    "codex",
    "claude",
    "grok",
    "copilot",
    "antigravity"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
